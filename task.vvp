    .scope S_0x100c45800;
T_1 ;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x100c49230_0, 0, 8;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x100c490f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x100c49190_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x100c42a20;
T_2 ;
    %vpi_call 2 11 "$dumpfile", "task.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x100c42a20 {0 0 0};
    %pushi/vec4 18, 0, 8;
    %store/vec4 v0x100c492d0_0, 0, 8;
    %pushi/vec4 52, 0, 8;
