#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x10109ec30 .scope module, "repeat_example" "repeat_example" 2 1;
 .timescale 0 0;
v0x10109c8b0_0 .var "r_Clock", 0 0;
    .scope S_0x10109ec30;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10109c8b0_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x10109ec30;
T_1 ;
    %vpi_call 2 6 "$dumpfile", "repeatloop.vcd" {0 0 0};
    %vpi_call 2 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x10109ec30 {0 0 0};
    %pushi/vec4 10, 0, 32;
T_1.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_1.1, 5;
    %jmp/1 T_1.1, 4;
    %subi 1, 0, 32;
    %delay 5, 0;
    %load/vec4 v0x10109c8b0_0;
    %nor/r;
    %store/vec4 v0x10109c8b0_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %pop/vec4 1;
    %vpi_call 2 12 "$display", "Simulation Complete" {0 0 0};
    %vpi_call 2 14 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "repeatloop.v";
