#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x102dd3ac0 .scope module, "function_auto" "function_auto" 2 2;
 .timescale 0 0;
S_0x102dd3c40 .scope function.vec4.s8, "factorial" "factorial" 2 4, 2 4 0, S_0x102dd3ac0;
 .timescale 0 0;
; Variable factorial is vec4 return value of scope S_0x102dd3c40
v0x102dd4240_0 .var "i_Num", 3 0;
TD_function_auto.factorial ;
    %load/vec4 v0x102dd4240_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 1, 0, 8;
    %ret/vec4 0, 0, 8;  Assign to factorial (store_vec4_to_lval)
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x102dd4240_0;
    %pad/u 8;
    %load/vec4 v0x102dd4240_0;
    %subi 1, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %mul;
    %ret/vec4 0, 0, 8;  Assign to factorial (store_vec4_to_lval)
T_0.1 ;
    %end;
    .scope S_0x102dd3ac0;
T_1 ;
    %vpi_call 2 15 "$dumpfile", "autofunction.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x102dd3ac0 {0 0 0};
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %vpi_call 2 17 "$display", "Factorial of 1 = %d", S<0,vec4,u8> {1 0 0};
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %vpi_call 2 18 "$display", "Factorial of 2 = %d", S<0,vec4,u8> {1 0 0};
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %vpi_call 2 19 "$display", "Factorial of 3 = %d", S<0,vec4,u8> {1 0 0};
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %vpi_call 2 20 "$display", "Factorial of 4 = %d", S<0,vec4,u8> {1 0 0};
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x102dd4240_0, 0, 4;
    %callf/vec4 TD_function_auto.factorial, S_0x102dd3c40;
    %vpi_call 2 21 "$display", "Factorial of 5 = %d", S<0,vec4,u8> {1 0 0};
    %delay 10, 0;
    %vpi_call 2 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "autofunction.v";
