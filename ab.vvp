S_0x104f817f0 .scope module, "d_ff_tb" "d_ff_tb" 2 19;
 .timescale -6 -9;
v0x104f85a30_0 .var "r_CLK_TB", 0 0;
v0x104f85ad0_0 .var "r_D_TB", 0 0;
v0x104f85b70_0 .net "w_QBAR_TB", 0 0, v0x104f85990_0;  1 drivers
v0x104f85c10_0 .net "w_Q_TB", 0 0, v0x104f858f0_0;  1 drivers
S_0x104f7e820 .scope module, "UUT" "d_ff" 2 25, 2 3 0, S_0x104f817f0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "i_clk";
    .port_info 1 /INPUT 1 "i_d";
    .port_info 2 /OUTPUT 1 "o_q";
    .port_info 3 /OUTPUT 1 "o_qbar";
v0x104f7e9a0_0 .net "i_clk", 0 0, v0x104f85a30_0;  1 drivers
v0x104f7ea40_0 .net "i_d", 0 0, v0x104f85ad0_0;  1 drivers
v0x104f858f0_0 .var "o_q", 0 0;
v0x104f85990_0 .var "o_qbar", 0 0;
E_0x104f84080 .event posedge, v0x104f7e9a0_0;
    .scope S_0x104f7e820;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f858f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x104f85990_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x104f7e820;
T_1 ;
    %wait E_0x104f84080;
    %load/vec4 v0x104f7ea40_0;
    %assign/vec4 v0x104f858f0_0, 0;
    %load/vec4 v0x104f7ea40_0;
    %nor/r;
    %assign/vec4 v0x104f85990_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x104f817f0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x104f85a30_0;
    %nor/r;
    %store/vec4 v0x104f85a30_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x104f817f0;
T_3 ;
    %vpi_call 2 33 "$dumpfile", "abw.vcd" {0 0 0};
    %vpi_call 2 34 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x104f817f0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x104f85a30_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x104f85ad0_0, 0;
    %delay 40000, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x104f85ad0_0, 0;
    %delay 40000, 0;
    %vpi_call 2 40 "$finish" {0 0 0};
    %end;
    .thread T_3;
